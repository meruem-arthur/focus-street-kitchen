# Copy this file to .env and fill in real values.
# Never commit .env — it's already covered by .gitignore.

# ── Database (Neon) ──────────────────────────────────────────
# Neon dashboard → your project → "Connect" → copy the connection string
# (use the pooled connection string). Looks like:
# postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Staff sessions ───────────────────────────────────────────
# Any long random string — used to sign staff login cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# ── Paystack ─────────────────────────────────────────────────
# Paystack dashboard → Settings → API Keys & Webhooks.
# Use the TEST keys while developing, LIVE keys only in production.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Paystack doesn't issue a separate "webhook secret" — the webhook is
# verified using PAYSTACK_SECRET_KEY (see src/routes/api/paystack/webhook.ts).
# Set the webhook URL in the Paystack dashboard to:
#   https://YOUR_DOMAIN/api/paystack/webhook

# ── One-time admin account (used only by `bun run db:seed`) ────
# Set these, run the seed once, then you can remove them from .env.
STAFF_ADMIN_NAME=Admin
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=
